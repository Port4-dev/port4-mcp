{
  "name": "port4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web",
    "deploy": "npm run build:web && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "db:migrate:local": "wrangler d1 migrations apply port4-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply port4-db --remote"
  },
  "dependencies": {
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.14.0"
  }
}
